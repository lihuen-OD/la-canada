# Variables de entorno de La Cañada — monorepo (frontend + backend).
# Copiá este archivo a ".env" en la raíz del proyecto y completá los valores
# locales. Nunca commitees el ".env" real (ya está en .gitignore).
#
# El backend carga este archivo desde la raíz (ver backend/src/config/index.ts).
# El frontend (Vite) también lee desde la raíz gracias a `envDir` en
# frontend/vite.config.ts — solo las variables prefijadas con VITE_ llegan al
# navegador; el resto queda exclusivamente en el backend.

# ── Backend — usadas ya en esta etapa ──────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origen exacto permitido por CORS. Sin este valor, el backend no arranca.
FRONTEND_URL=http://localhost:5173

# ── Frontend — usada ya en esta etapa ──────────────────────────────────────
# Base URL de la API que consume el frontend (incluye el prefijo de versión).
VITE_API_URL=http://localhost:4000/api/v1

# ── Neon (Etapa 3A) — DOS conexiones distintas, no intercambiables ────────
#    DATABASE_URL: conexión POOLED de la rama `demo` (host con "-pooler" en
#    Neon). La usan el backend en runtime (vía @prisma/adapter-pg) y el seed.
#    OBLIGATORIA: el backend no arranca sin ella (ver backend/src/config/env.ts).
#    DIRECT_URL: conexión DIRECTA de la misma rama `demo` (mismo host, sin
#    "-pooler"). La usa exclusivamente Prisma Migrate
#    (backend/prisma.config.ts) — las migraciones no deben correr a través
#    del pooler. Opcional para arrancar el servidor; solo hace falta para
#    migrar.
#    NUNCA copiar acá un valor real — completar solo en el `.env` local
#    (gitignored). En esta etapa, ambas apuntan siempre a la rama `demo`; la
#    rama `production` usa sus propias variables, configuradas directamente
#    en el dashboard de Render, nunca en este archivo ni en un `.env`
#    commiteado.
DATABASE_URL=
DIRECT_URL=

#    DATABASE_TARGET: gate explícito (demo | production) que exigen los
#    scripts locales con capacidad de escritura (seed, migraciones, tests de
#    integración) antes de tocar la base — ver
#    backend/src/scripts/guardDbCommand.ts. En el `.env` local debe ser
#    exactamente "demo"; nunca "production" desde una máquina de
#    desarrollo. Nunca lleva prefijo VITE_ (exclusivo del backend).
DATABASE_TARGET=

# ── Autenticación (Etapa 3B.1) ─────────────────────────────────────────────
#    JWT_ACCESS_SECRET: secreto compartido para firmar/validar el access
#    token (HS256, vía `jose`) — mínimo 32 caracteres (256 bits). Generarlo
#    con, por ejemplo, `openssl rand -base64 48` y pegarlo únicamente en el
#    `.env` local (nunca acá). OBLIGATORIA: sin ella el backend directamente
#    no arranca (falla en backend/src/config/env.ts, misma fuente de verdad
#    que DATABASE_URL) — no es solo "necesaria para que auth funcione".
#    No existe JWT_REFRESH_SECRET: el refresh token es un valor opaco
#    generado con bytes aleatorios (no un JWT), no hay nada que firmar del
#    lado del servidor — ver docs/SECURITY.md.
#    ACCESS_TOKEN_TTL / REFRESH_TOKEN_TTL: en segundos. Default si se dejan
#    vacías: 720 (12 min) y 2592000 (30 días) respectivamente.
#    COOKIE_SAME_SITE: lax | strict | none. Si se deja vacía, usa "none" en
#    producción (Netlify y Render son dominios distintos — cross-site real)
#    y "lax" en desarrollo local. "none" exige Secure siempre (se deriva
#    solo, ver backend/src/config/cookies.ts) — ver docs/ARCHITECTURE.md,
#    "Cookies y CSRF".
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
COOKIE_SAME_SITE=

# ── Previstas para la integración con Object Storage (etapa futura) ───────
#    Almacenamiento de fotografías y archivos (ver docs/ARCHITECTURE.md,
#    "Object Storage"). Nombres conceptuales/internos del backend: si la
#    interfaz real del proveedor expone nombres de variable distintos, deben
#    mapearse a estos al configurar el entorno. Ninguna lleva prefijo VITE_
#    — el frontend nunca recibe credenciales de almacenamiento. Sin valores
#    reales acá; no son obligatorias todavía porque el módulo de archivos no
#    está implementado.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
